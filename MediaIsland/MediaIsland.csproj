<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PlatformTarget>x64</PlatformTarget>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableDynamicLoading>True</EnableDynamicLoading>
		<WindowsProviderProject>..\MediaIsland.Windows\MediaIsland.Windows.csproj</WindowsProviderProject>
		<WindowsProviderTargetFramework>net8.0-windows10.0.17763</WindowsProviderTargetFramework>
		<TtmlNativeManifest>$(MSBuildProjectDirectory)\..\native\ttml-ffi\Cargo.toml</TtmlNativeManifest>
		<!-- Cargo crate/lib names cannot contain '.'; cargo emits mediaisland_ttml.dll, then we ship MediaIsland.Ttml.dll. -->
		<TtmlNativeCargoOutput>$(MSBuildProjectDirectory)\..\native\ttml-ffi\target\release\mediaisland_ttml.dll</TtmlNativeCargoOutput>
		<TtmlNativeLibraryName>MediaIsland.Ttml.dll</TtmlNativeLibraryName>
		<TtmlNativeLibrary>$(MSBuildProjectDirectory)\..\native\ttml-ffi\target\release\$(TtmlNativeLibraryName)</TtmlNativeLibrary>
		<AudioNativeManifest>$(MSBuildProjectDirectory)\..\native\audio-ffi\Cargo.toml</AudioNativeManifest>
		<AudioNativeCargoOutput>$(MSBuildProjectDirectory)\..\native\audio-ffi\target\release\mediaisland_audio.dll</AudioNativeCargoOutput>
		<AudioNativeLibraryName>MediaIsland.Audio.dll</AudioNativeLibraryName>
		<AudioNativeLibrary>$(MSBuildProjectDirectory)\..\native\audio-ffi\target\release\$(AudioNativeLibraryName)</AudioNativeLibrary>
		<!-- Keep in lockstep with manifest.yml: the host displays the manifest
		     version, but a stale assembly version makes crash reports and
		     `PluginStartupLog` disagree with what users see in the plugin list. -->
		<Version>1.2.3</Version>
		<AssemblyVersion>1.2.3</AssemblyVersion>
		<FileVersion>1.2.3</FileVersion>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="ClassIsland.PluginSdk" Version="2.1.0.1">
			<ExcludeAssets>runtime; native</ExcludeAssets>
		</PackageReference>
		<!-- Avalonia's build targets (the XamlIl compiler) are only imported for a direct
		     reference. Without this the .axaml files end up embedded as plain resources and
		     InitializeComponent() throws "No precompiled XAML found" at runtime.
		     Runtime/native assets stay out of the output: the host already provides Avalonia. -->
		<PackageReference Include="Avalonia" Version="11.3.17">
			<ExcludeAssets>runtime; native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Sentry" Version="5.8.1" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="$(TtmlNativeLibrary)">
			<Link>runtimes\win-x64\native\$(TtmlNativeLibraryName)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(TtmlNativeLibrary)">
			<Link>$(TtmlNativeLibraryName)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(AudioNativeLibrary)">
			<Link>runtimes\win-x64\native\$(AudioNativeLibraryName)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(AudioNativeLibrary)">
			<Link>$(AudioNativeLibraryName)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="ThirdPartyLicenses.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="manifest.yml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>


	<ItemGroup>
	  <AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<Target Name="BuildAndCopyWindowsProvider" AfterTargets="Build" Condition="'$(BuildingWindowsProvider)' != 'true' And Exists('$(WindowsProviderProject)')">
		<MSBuild Projects="$(WindowsProviderProject)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform);BuildingWindowsProvider=true" />
		<ItemGroup>
			<_WindowsProviderOutput Include="$(MSBuildProjectDirectory)\..\MediaIsland.Windows\bin\$(Configuration)\$(WindowsProviderTargetFramework)\MediaIsland.Windows.dll" />
			<_WindowsProviderOutput Include="$(MSBuildProjectDirectory)\..\MediaIsland.Windows\bin\$(Configuration)\$(WindowsProviderTargetFramework)\MediaIsland.Windows.pdb" />
			<_WindowsProviderOutput Include="$(MSBuildProjectDirectory)\..\MediaIsland.Windows\bin\$(Configuration)\$(WindowsProviderTargetFramework)\MediaIsland.Windows.deps.json" />
		</ItemGroup>
		<Copy SourceFiles="@(_WindowsProviderOutput)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('%(_WindowsProviderOutput.FullPath)')" />
	</Target>

	<Target Name="BuildTtmlNative"
	        BeforeTargets="PrepareForBuild"
	        Inputs="$(TtmlNativeManifest);$(MSBuildProjectDirectory)\..\native\ttml-ffi\Cargo.lock;$(MSBuildProjectDirectory)\..\native\ttml-ffi\src\*.rs"
	        Outputs="$(TtmlNativeLibrary)"
	        Condition="'$(OS)' == 'Windows_NT' And '$(PlatformTarget)' == 'x64' And Exists('$(TtmlNativeManifest)')">
		<Exec Command="cargo build --manifest-path &quot;$(TtmlNativeManifest)&quot; --release" />
		<Copy SourceFiles="$(TtmlNativeCargoOutput)" DestinationFiles="$(TtmlNativeLibrary)" SkipUnchangedFiles="true" />
	</Target>

	<!-- Inputs globs src\*.rs instead of enumerating: audio-ffi is multi-module, and an
	     enumeration goes stale the moment a module is added — ring.rs and render.rs were both
	     missed that way, and a missed module silently ships a DLL that predates the edit. -->
	<Target Name="BuildAudioNative"
	        BeforeTargets="PrepareForBuild"
	        Inputs="$(AudioNativeManifest);$(MSBuildProjectDirectory)\..\native\audio-ffi\Cargo.lock;$(MSBuildProjectDirectory)\..\native\audio-ffi\src\*.rs"
	        Outputs="$(AudioNativeLibrary)"
	        Condition="'$(OS)' == 'Windows_NT' And '$(PlatformTarget)' == 'x64' And Exists('$(AudioNativeManifest)')">
		<Exec Command="cargo build --manifest-path &quot;$(AudioNativeManifest)&quot; --release" />
		<Copy SourceFiles="$(AudioNativeCargoOutput)" DestinationFiles="$(AudioNativeLibrary)" SkipUnchangedFiles="true" />
	</Target>
	<!-- CreateCipx 会把 $(OutputPath) 整个压成包，而 `dotnet publish` 会往
	     bin\<配置>\<TFM>\publish\ 再写一份。下一次打包时这份残留（里面还躺着一份旧的
	     MediaIsland.dll）会被一起压进 .cipx：包体积翻倍，还同时带着两个版本的插件。
	     打第二个包之前先把它清掉。 -->
	<Target Name="CleanStalePublishDir" BeforeTargets="CreateCipx" Condition="Exists('$(OutputPath)publish')">
		<RemoveDir Directories="$(OutputPath)publish" />
	</Target>

</Project>
